# LLM providers — use at least one
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# Groq (Llama 3.1 8B) — third LLM fallback; get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Search APIs — ordered fallback chain: Tavily -> Serper -> Exa
TAVILY_API_KEY=api_key_here
SERPER_API_KEY=your_serper_api_key_here
EXA_API_KEY=api_key_here

# Page parsing — Firecrawl used only for JS-rendered sites (fallback)
FIRECRAWL_API_KEY=api_key_here
