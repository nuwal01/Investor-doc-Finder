# Secrets / credentials (keep .env.example, which is the committed template)
.env

# SQLite cache — runtime state, per CLAUDE.md "do not commit"; WAL mode adds sidecars
cache.db
cache.db-wal
cache.db-shm
# timestamped backups from cleanup_cache_keys.py / sweep_cache.py (no inline comments — gitignore treats # literally)
cache.db.bak-*

# Cache-sweep runtime state (sweep_cache.py): the last-swept marker + purge audit log
sweep_meta.json
cache_sweeps.log

# SQLite search-history store — runtime state (per-session log), WAL sidecars too
history.db
history.db-wal
history.db-shm

# Generated artifacts
converted_pdfs/
batch_results.json
# EDGAR tickers cache — regenerated data, not source: resolver._load_tickers()
# re-downloads it from sec.gov when missing/stale (24h TTL), so it need not be
# tracked; committing it just churns a 700KB single-line blob on every refresh.
data/edgar_tickers.json

# Python bytecode / test caches
__pycache__/
*.pyc
.pytest_cache/

# Local editor / IDE state
.vscode/
